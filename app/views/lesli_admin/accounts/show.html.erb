<%= render(LesliView::Layout::Container.new("accounts")) do %>
    <%= render(
        LesliView::Components::Header.new(
            "Account",
            "Manage the core identity, company profile, and resources for #{@account.name}."
        )
    ) %>

    <% if @account.errors.any? %>
        <div class="mb-6 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700" role="alert">
            <p class="font-semibold">The account could not be updated.</p>
            <ul class="mt-2 list-disc space-y-1 pl-5">
                <% @account.errors.full_messages.each do |message| %>
                    <li><%= message %></li>
                <% end %>
            </ul>
        </div>
    <% end %>

    <%= render LesliView::Components::Tabs.new do |tabs| %>
        <% tabs.with_tab(id: "general", title: "General", icon: "business") do %>
            <%= form_with(model: @account, url: account_path, builder: LesliView::Forms::Builder) do |form| %>
                <%= form.fieldset("Core account") do %>
                    <p class="mb-5 text-sm leading-6 text-slate-500">
                        These values identify the account throughout every installed Lesli engine.
                    </p>

                    <div class="grid grid-cols-1 gap-x-5 md:grid-cols-2">
                        <%= form.field_control(
                            :name,
                            label: "Account name",
                            autocomplete: "organization",
                            required: true
                        ) %>
                        <%= form.field_control_email(
                            :email,
                            label: "Account email",
                            autocomplete: "email",
                            required: true
                        ) %>
                        <%= form.field_control_select(
                            :status,
                            Lesli::Account.statuses.keys.map { |status| [status, status] },
                            label: "Status"
                        ) %>
                        <%= form.field_control_select(
                            :region,
                            Lesli::Account.regions.keys.map { |region| [region, region] },
                            label: "Data region"
                        ) %>
                    </div>

                    <div class="mt-2 flex justify-end">
                        <%= form.field_control_button("Save account", category: "primary", icon: "save") %>
                    </div>
                <% end %>
            <% end %>
        <% end %>

        <% tabs.with_tab(id: "company-profile", title: "Company profile", icon: "domain") do %>
            <%= form_with(model: @account, url: account_path, builder: LesliView::Forms::Builder) do |form| %>
                <%= form.fields_for(:detail) do |detail| %>
                    <%= detail.fieldset("Company information") do %>
                        <div class="grid grid-cols-1 gap-x-5 md:grid-cols-2">
                            <%= detail.field_control(:company_name, label: "Public company name", autocomplete: "organization") %>
                            <%= detail.field_control(:company_name_legal, label: "Legal company name") %>
                            <div class="md:col-span-2">
                                <%= detail.field_control(:company_tagline, label: "Tagline") %>
                            </div>
                        </div>
                    <% end %>

                    <%= detail.fieldset("Address and contact") do %>
                        <div class="grid grid-cols-1 gap-x-5 md:grid-cols-2">
                            <div class="md:col-span-2">
                                <%= detail.field_control(:address, label: "Address", autocomplete: "street-address") %>
                            </div>
                            <%= detail.field_control(:city, label: "City", autocomplete: "address-level2") %>
                            <%= detail.field_control(:region, label: "State or region", autocomplete: "address-level1") %>
                            <%= detail.field_control(
                                :country,
                                label: "Country catalog ID",
                                message: "Numeric identifier from the configured country catalog.",
                                type: "number",
                                min: 0
                            ) %>
                            <%= detail.field_control(:postal_code, label: "Postal code", autocomplete: "postal-code") %>
                            <%= detail.field_control_email(:public_email, label: "Public email", autocomplete: "email") %>
                            <%= detail.field_control(:website, label: "Website", type: "url", autocomplete: "url") %>
                            <%= detail.field_control(:phone_number_1, label: "Primary phone", type: "tel", autocomplete: "tel") %>
                            <%= detail.field_control(:phone_number_2, label: "Secondary phone", type: "tel") %>
                            <%= detail.field_control(:phone_number_3, label: "Additional phone 1", type: "tel") %>
                            <%= detail.field_control(:phone_number_4, label: "Additional phone 2", type: "tel") %>
                        </div>
                    <% end %>

                    <%= detail.fieldset("Social profiles") do %>
                        <div class="grid grid-cols-1 gap-x-5 md:grid-cols-2">
                            <%= detail.field_control(:github, label: "GitHub", type: "url") %>
                            <%= detail.field_control(:linkedin, label: "LinkedIn", type: "url") %>
                            <%= detail.field_control(:twitter, label: "X / Twitter", type: "url") %>
                            <%= detail.field_control(:facebook, label: "Facebook", type: "url") %>
                            <%= detail.field_control(:youtube, label: "YouTube", type: "url") %>
                        </div>

                        <div class="mt-2 flex justify-end">
                            <%= detail.field_control_button("Save company profile", category: "primary", icon: "save") %>
                        </div>
                    <% end %>
                <% end %>
            <% end %>
        <% end %>
    <% end %>
<% end %>
