<%# Widgets also render through LesliDashboard; share one summary per view render. %>
<% @account_summary ||= LesliAdmin::AccountService.new(current_user).summary %>

<%
    account = @account_summary[:account]
    status_classes = case account.status
    when "active"
        "bg-success-100 text-success-700"
    when "suspended"
        "bg-danger-100 text-danger-700"
    when "onboarding"
        "bg-warning-100 text-warning-700"
    else
        "bg-info-100 text-info-700"
    end
%>

<section class="h-full rounded-2xl border border-neutral-200 bg-white p-5 shadow-sm sm:p-6" aria-labelledby="account-metadata-title">
    <div class="flex flex-wrap items-start justify-between gap-4">
        <div>
            <h2 id="account-metadata-title" class="text-base font-semibold text-neutral-900">Account metadata</h2>
            <p class="mt-1 text-sm text-neutral-500">Read-only identifiers and lifecycle information.</p>
        </div>
        <span class="inline-flex items-center rounded-full px-2.5 py-1 text-xs font-semibold <%= status_classes %>">
            <%= account.status.humanize %>
        </span>
    </div>

    <dl class="mt-5 grid grid-cols-1 gap-x-6 gap-y-5 sm:grid-cols-2 xl:grid-cols-4">
        <div>
            <dt class="text-sm font-medium text-neutral-500">Account ID</dt>
            <dd class="mt-1 break-all text-sm text-neutral-900"><%= account.id %></dd>
        </div>
        <div>
            <dt class="text-sm font-medium text-neutral-500">Owner</dt>
            <dd class="mt-1 break-all text-sm text-neutral-900"><%= account.user&.email || "Not assigned" %></dd>
        </div>
        <div>
            <dt class="text-sm font-medium text-neutral-500">Created</dt>
            <dd class="mt-1 text-sm text-neutral-900"><%= l(account.created_at, format: :long) %></dd>
        </div>
        <div>
            <dt class="text-sm font-medium text-neutral-500">Last updated</dt>
            <dd class="mt-1 text-sm text-neutral-900"><%= l(account.updated_at, format: :long) %></dd>
        </div>
    </dl>
</section>
