<%
    sensitive_key = setting_key.to_s.match?(/password|secret|token|api[_-]?key|private[_-]?key|credential|encryption|salt/i)
%>

<% if sensitive_key %>
    <span class="inline-flex items-center gap-1.5 rounded-full bg-slate-200 px-2.5 py-1 text-xs font-semibold text-slate-600">
        <span class="material-symbols-outlined text-sm" aria-hidden="true">lock</span>
        Filtered
    </span>
<% elsif value.is_a?(Hash) %>
    <dl class="space-y-2">
        <% value.each do |nested_key, nested_value| %>
            <div class="rounded-lg border border-slate-200 bg-white p-3">
                <dt class="text-xs font-medium text-slate-500"><%= nested_key.to_s.humanize %></dt>
                <dd class="mt-1.5">
                    <%= render("configuration_value", setting_key: nested_key, value: nested_value) %>
                </dd>
            </div>
        <% end %>
    </dl>
<% elsif value.is_a?(Array) %>
    <% if value.empty? %>
        <span class="text-slate-400">Empty list</span>
    <% else %>
        <ul class="flex flex-wrap gap-2">
            <% value.each do |item| %>
                <li class="rounded-lg border border-slate-200 bg-white px-2.5 py-1 text-xs text-slate-700">
                    <%= render("configuration_value", setting_key: :item, value: item) %>
                </li>
            <% end %>
        </ul>
    <% end %>
<% elsif value == true %>
    <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-100 px-2.5 py-1 text-xs font-semibold text-emerald-700">
        <span class="h-1.5 w-1.5 rounded-full bg-emerald-500" aria-hidden="true"></span>
        Enabled
    </span>
<% elsif value == false %>
    <span class="inline-flex items-center gap-1.5 rounded-full bg-red-100 px-2.5 py-1 text-xs font-semibold text-red-700">
        <span class="h-1.5 w-1.5 rounded-full bg-red-500" aria-hidden="true"></span>
        Disabled
    </span>
<% elsif value.nil? %>
    <span class="italic text-slate-400">Not configured</span>
<% elsif value.to_s.match?(/\A#[0-9a-f]{3,8}\z/i) %>
    <span class="inline-flex items-center gap-2">
        <span class="h-5 w-5 rounded-md border border-slate-300 shadow-sm" style="background-color: <%= value %>" aria-hidden="true"></span>
        <code class="break-all rounded-md bg-slate-200 px-2 py-1 text-xs text-slate-700"><%= value %></code>
    </span>
<% else %>
    <code class="break-all rounded-md bg-slate-200 px-2 py-1 text-xs leading-5 text-slate-700"><%= value %></code>
<% end %>
