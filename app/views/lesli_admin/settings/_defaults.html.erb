<%
    sections = {
        "Instance Info" => {
            demo: Lesli.config.demo,
            instance: Lesli.config.instance
        },
        "Company Info" => Lesli.config.company,
        "Available Locales" => Lesli.config.babel[:locales],
        "Datetime Settings" => Lesli.config.datetime,
        "Security Settings" => Lesli.config.security,
        "Theme" => Lesli.config.theme,
        "Layout" => Lesli.config.layout,
        "Mailer" => Lesli.config.mailer,
        "Paths" => {
            path_after_login: Lesli.config.shield[:path_after_login]
        }
    }

    grid_classes = {
        "Instance Info" => "sm:grid-cols-2 lg:grid-cols-4",
        "Datetime Settings" => "sm:grid-cols-2",
        "Security Settings" => "sm:grid-cols-2 lg:grid-cols-4",
        "Theme" => "sm:grid-cols-2 lg:grid-cols-3"
    }
%>

<section aria-labelledby="lesli-configuration-title">
    <h4
        id="lesli-configuration-title"
        class="mb-5 text-xl font-semibold tracking-tight text-slate-900">
        Lesli Configuration
    </h4>

    <div class="space-y-5">
        <% sections.each do |title, config| %>
            <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6">
                <h5 class="mb-4 text-base font-semibold text-slate-900"><%= title %></h5>

                <dl class="grid grid-cols-1 gap-x-6 gap-y-5 <%= grid_classes.fetch(title, "sm:grid-cols-2 lg:grid-cols-4") %>">
                <% config.each do |key, value| %>
                    <div class="min-w-0">
                        <dt class="text-sm font-medium text-slate-600"><%= key.to_s.humanize %></dt>
                        <dd class="mt-2 text-sm text-slate-900">
                            <% if value.is_a?(Hash) %>
                                <ul class="space-y-2 border-l-2 border-slate-200 pl-3">
                                    <% value.each do |nested_key, nested_value| %>
                                        <li class="min-w-0">
                                            <span class="font-medium text-slate-700"><%= nested_key.to_s.humanize %>:</span>
                                            <code class="ml-1 break-all rounded bg-slate-100 px-1.5 py-0.5 text-xs text-slate-700"><%= nested_value %></code>
                                        </li>
                                    <% end %>
                                </ul>
                            <% elsif value == true %>
                                <span class="inline-flex items-center rounded-full bg-emerald-100 px-2.5 py-1 text-xs font-semibold text-emerald-700">
                                    Enabled
                                </span>
                            <% elsif value == false %>
                                <span class="inline-flex items-center rounded-full bg-red-100 px-2.5 py-1 text-xs font-semibold text-red-700">
                                    Disabled
                                </span>
                            <% else %>
                                <code class="break-all rounded bg-slate-100 px-1.5 py-1 text-xs text-slate-700"><%= value.to_s %></code>
                            <% end %>
                        </dd>
                    </div>
                <% end %>
                </dl>
            </article>
        <% end %>
    </div>
</section>
